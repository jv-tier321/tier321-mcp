{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tier321-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1" },
  "vars": { "MCP_ALLOWED_ORIGINS": "" },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.mdx", "**/*.md"],
      "fallthrough": true
    }
  ],
  // Replace with your deployment domain. Leave this commented out (or
  // remove the block entirely) to deploy to the default <worker>.workers.dev
  // subdomain for testing.
  // "routes": [
  //   { "pattern": "mcp.example.com", "custom_domain": true }
  // ],
  "alias": {
    "ajv": "./test/__stubs__/ajv.js",
    "ajv-formats": "./test/__stubs__/ajv-formats.js"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      // Any unused integer for your account — namespace IDs are account-scoped
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 10
      }
    }
  ],
  "env": {
    "staging": {
      "name": "tier321-mcp-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": { "MCP_ALLOWED_ORIGINS": "" },
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          // Separate from the default environment's account-scoped counter.
          // Fork operators must choose an unused namespace in their account.
          "namespace_id": "32102001",
          "simple": { "limit": 20, "period": 10 }
        }
      ]
    }
  }
}
